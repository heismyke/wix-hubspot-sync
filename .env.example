# Public HTTPS origin of this app (OAuth redirect + webhook URLs are derived from it)
PUBLIC_BASE_URL=https://wix-hubspot.example.com

# Postgres (docker-compose) — or set DATABASE_URL to a Supabase connection string
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://postgres:<pw>@db.<project>.supabase.co:5432/postgres?sslmode=require

# Wix Dev Center → your app → OAuth (App ID / Secret) and Webhooks (Public key)
WIX_APP_ID=
WIX_APP_SECRET=
# one line, newlines written as \n: -----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
WIX_PUBLIC_KEY=

# HubSpot developer account → app → Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

LOG_LEVEL=info
POLL_INTERVAL_SECONDS=60
